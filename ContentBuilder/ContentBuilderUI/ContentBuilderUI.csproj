<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<TargetName>ContentBuilderUI</TargetName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<StartupObject>ContentBuilderUI.Program</StartupObject>
		<AssemblyName>ContentBuilderUI</AssemblyName>
		<RootNamespace>ContentBuilderUI</RootNamespace>
		<TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>hammer-icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Content\**\*.*">
			<!-- Should almost never use "Always": -->
			<!-- https://www.mrlacey.com/2020/06/never-set-copy-to-output-directory-to.html -->
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);lib\**\*</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ContentProcessor\ContentProcessor.csproj" />
		<ProjectReference Include="..\..\lib\MoonWorks\MoonWorks.csproj" />
		<ProjectReference Include="..\..\lib\Hexa.NET.ImGui\Hexa.NET.ImGui\Hexa.NET.ImGui.csproj" />
		<ProjectReference Include="..\..\lib\Hexa.NET.ImGui\Hexa.NET.ImGui.Backends.SDL3\Hexa.NET.ImGui.Backends.SDL3.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\src\ImGuiBackend.cs" />
	</ItemGroup>

	<Import Project=".\CopyMoonlibs.targets" />
</Project>
